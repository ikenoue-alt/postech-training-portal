}.detail{margin-top:18px;padding-top:18px;border-top:1px solid #e5ece5}.detail[hidden]{display:none}.summary-field{margin-top:20px}footer{position:fixed;bottom:0;left:0;right:0;background:white;border-top:1px solid #dce5dc;padding:14px 18px;z-index:4}.footer-inner{max-width:850px;margin:auto;display:flex;align-items:center;justify-content:space-between;gap:12px}#submit{background:#247d3c;color:white;font-weight:bold;padding:13px 24px}button:disabled{opacity:.55;cursor:default}#status{white-space:pre-wrap;font-size:14px;line-height:1.7}#status[data-error=true]{color:#ad241f}.success{background:#e8f5e9;border-color:#81bc8b}.success h2{color:#217337}.draft{font-size:12px;color:#5b6d60}.draft.error{color:#ad241f}#formContent[hidden],#success[hidden]{display:none}@media(max-width:600px){.grid{grid-template-columns:1fr}main{padding:0 12px 150px}section,article{padding:19px 16px}h1{font-size:23px}.title{font-size:17px}.choices button{min-width:calc(50% - 8px)}header{padding:13px 15px}.footer-inner{align-items:start;flex-direction:column}#submit{width:100%}}\n</style></head><body><header><strong>フォローアップ確認</strong><span id=\"progress\" class=\"progress\">0 / 14</span></header><main>\n<div id=\"formContent\"><a href=\"https://ikenoue-alt.github.io/postech-training-portal/\">← ホームに戻る</a><h1>フォローアップ確認フォーム</h1><p class=\"lead\">各項目の基準で1〜4点を選択してください。初回の説明・実演後、同じ項目を3回確認し、その間に必要だった追加の声掛け・補助で評価します。確認機会が足りない場合は「確認できず」。安全のための停止・相談は減点しません。</p>\n<form id=\"reportForm\"><section aria-label=\"基本情報\"><h2>基本情報</h2><div class=\"grid\"><div><label for=\"trainee\">配布員名</label><input id=\"trainee\" autocomplete=\"name\" maxlength=\"100\" required></div><div><label for=\"trainer\">研修員名</label><input id=\"trainer\" maxlength=\"100\" required></div><div><label for=\"date\">確認日</label><input id=\"date\" type=\"date\" required></div><div><label for=\"delivery\">今回の配布</label><select id=\"delivery\" required><option value=\"\">選択してください</option><option>単配</option><option>併配</option></select></div></div></section><div id=\"questions\"></div><section><h2>今回のまとめ</h2><div><label for=\"issue\">今回の課題</label><textarea id=\"issue\" maxlength=\"5000\"></textarea></div><div class=\"summary-field\"><label for=\"taught\">今回伝えたこと・指導後の変化</label><textarea id=\"taught\" maxlength=\"5000\"></textarea></div><div class=\"summary-field\"><label for=\"share\">社員への共有</label><textarea id=\"share\" maxlength=\"5000\" placeholder=\"共有がある場合に記入してください\"></textarea></div></section><p class=\"draft\" id=\"draftStatus\" role=\"status\"></p></form></div>\n<section id=\"success\" class=\"success\" hidden><h2>回答を保存しました</h2><p>研修レポートの「フォローアップ」タブに保存しました。</p><p id=\"savedInfo\"></p><button id=\"next\" type=\"button\">次の配布員の回答を入力する</button></section>\n</main><footer><div class=\"footer-inner\"><span id=\"status\" role=\"status\" aria-live=\"polite\">残り14項目</span><button id=\"submit\" form=\"reportForm\" type=\"submit\">記録を提出する</button></div></footer>\n<script>\n'use strict';\nconst QUESTIONS=[{\"id\":\"q16\",\"note\":\"\",\"options\":[{\"label\":\"実演した\",\"value\":\"done\"},{\"label\":\"実演しなかった\",\"value\":\"notdone\"}],\"originalNumber\":1,\"reasons\":[\"理解不足\",\"判断に迷った\",\"忘れていた\",\"動きがまだ身についていない\",\"今回は実施なし・該当場面なし\",\"その他\"],\"rubric\":[],\"title\":\"研修担当者が自分で配布し、実演して見せた\"},{\"id\":\"q04\",\"note\":\"完全な事業所は投函しない。住居兼事業所は投函する。この違いを見分けられたか。\",\"options\":[{\"label\":\"4｜自立\",\"value\":\"p4\"},{\"label\":\"3｜軽微フォロー\",\"value\":\"p3\"},{\"label\":\"2｜継続フォロー\",\"value\":\"p2\"},{\"label\":\"1｜介入必要\",\"value\":\"p1\"},{\"label\":\"－ 確認できず（採点対象外）\",\"value\":\"na\"}],\"originalNumber\":2,\"reasons\":[\"理解不足\",\"判断に迷った\",\"忘れていた\",\"動きがまだ身についていない\",\"今回は実施なし・該当場面なし\",\"その他\"],\"rubric\":[\"4：住居兼事業所と完全な事業所を自分で見分け、正しく判断した\",\"3：1回の説明後は自分で正しく判断した\",\"2：2回以上の説明・確認が必要だった\",\"1：説明後も判断できず、担当者が投函可否を決めた\"],\"title\":\"事務所兼自宅と事業所を見分け、投函可否を正しく判断できた\"},{\"id\":\"q03\",\"note\":\"敷地へ入る前にポストの位置を確認し、正規な方法で配布できたか。\",\"options\":[{\"label\":\"4｜自立\",\"value\":\"p4\"},{\"label\":\"3｜軽微フォロー\",\"value\":\"p3\"},{\"label\":\"2｜継続フォロー\",\"value\":\"p2\"},{\"label\":\"1｜介入必要\",\"value\":\"p1\"},{\"label\":\"－ 確認できず（採点対象外）\",\"value\":\"na\"}],\"originalNumber\":3,\"reasons\":[\"理解不足\",\"判断に迷った\",\"忘れていた\",\"動きがまだ身についていない\",\"今回は実施なし・該当場面なし\",\"その他\"],\"rubric\":[\"4：敷地へ入る前に自分でポストの位置を確認した\",\"3：1回の声掛け後は入る前に確認した\",\"2：2回以上、位置確認の声掛けが必要だった\",\"1：担当者がポストの場所を示す必要があった\"],\"title\":\"配布前にポストの位置を確認できた\"},{\"id\":\"q12\",\"note\":\"集合住宅で集合ポストの場所を自分で探し、スムーズに到達できたか。\",\"options\":[{\"label\":\"4｜自立\",\"value\":\"p4\"},{\"label\":\"3｜軽微フォロー\",\"value\":\"p3\"},{\"label\":\"2｜継続フォロー\",\"value\":\"p2\"},{\"label\":\"1｜介入必要\",\"value\":\"p1\"},{\"label\":\"－ 確認できず（採点対象外）\",\"value\":\"na\"}],\"originalNumber\":4,\"reasons\":[\"理解不足\",\"判断に迷った\",\"忘れていた\",\"動きがまだ身についていない\",\"今回は実施なし・該当場面なし\",\"その他\"],\"rubric\":[\"4：自分で案内や建物を確認し、集合ポストを見つけた\",\"3：1回のヒント後は自分で見つけた\",\"2：2回以上のヒント・誘導が必要だった\",\"1：担当者が集合ポストまで案内した\"],\"title\":\"メールコーナーを見つけられた\"},{\"id\":\"q22\",\"note\":\"\",\"options\":[{\"label\":\"4｜自立\",\"value\":\"p4\"},{\"label\":\"3｜軽微フォロー\",\"value\":\"p3\"},{\"label\":\"2｜継続フォロー\",\"value\":\"p2\"},{\"label\":\"1｜介入必要\",\"value\":\"p1\"},{\"label\":\"－ 確認できず（採点対象外）\",\"value\":\"na\"}],\"originalNumber\":5,\"reasons\":[\"理解不足\",\"判断に迷った\",\"忘れていた\",\"動きがまだ身についていない\",\"今回は実施なし・該当場面なし\",\"その他\"],\"rubric\":[\"4：担当者が確認した範囲でポストの見落としがなかった\",\"3：1回の指摘後は見落とさず確認した\",\"2：2回以上、見落としの指摘が必要だった\",\"1：指摘後も見落としが続き、担当者が確認を代行した\"],\"title\":\"ポストの見落としを減らせた\"},{\"id\":\"q08\",\"note\":\"回る順番にかかわらず、当日必ず回る番地を飛ばさず、結果的に詰め配布となる効率的な回り方ができたか。\",\"options\":[{\"label\":\"4｜自立\",\"value\":\"p4\"},{\"label\":\"3｜軽微フォロー\",\"value\":\"p3\"},{\"label\":\"2｜継続フォロー\",\"value\":\"p2\"},{\"label\":\"1｜介入必要\",\"value\":\"p1\"},{\"label\":\"－ 確認できず（採点対象外）\",\"value\":\"na\"}],\"originalNumber\":6,\"reasons\":[\"理解不足\",\"判断に迷った\",\"忘れていた\",\"動きがまだ身についていない\",\"今回は実施なし・該当場面なし\",\"その他\"],\"rubric\":[\"4：対象番地を飛ばさず、自分で回る順番を決めた\",\"3：1回の助言後は番地を飛ばさず順番を決めた\",\"2：2回以上、回る順番の助言が必要だった\",\"1：担当者が回る順番をその都度指示した\"],\"title\":\"効率的な配布ができた\"},{\"id\":\"q14\",\"note\":\"自転車から持ち出す配布物の量を考え、配布物を取りに戻るだけの無駄足や、同じ道の往復を減らせたか。\",\"options\":[{\"label\":\"4｜自立\",\"value\":\"p4\"},{\"label\":\"3｜軽微フォロー\",\"value\":\"p3\"},{\"label\":\"2｜継続フォロー\",\"value\":\"p2\"},{\"label\":\"1｜介入必要\",\"value\":\"p1\"},{\"label\":\"－ 確認できず（採点対象外）\",\"value\":\"na\"}],\"originalNumber\":7,\"reasons\":[\"理解不足\",\"判断に迷った\",\"忘れていた\",\"動きがまだ身についていない\",\"今回は実施なし・該当場面なし\",\"その他\"],\"rubric\":[\"4：補充量と順路を考え、不要な取り戻り・往復がなかった\",\"3：1回の助言後は不要な往復をなくせた\",\"2：2回以上、補充量や往復について助言が必要だった\",\"1：担当者が補充量・順路を決めても不要な往復が続いた\"],\"title\":\"無駄な往復をせず回れた\"},{\"id\":\"q17\",\"note\":\"\",\"options\":[{\"label\":\"4｜自立\",\"value\":\"p4\"},{\"label\":\"3｜軽微フォロー\",\"value\":\"p3\"},{\"label\":\"2｜継続フォロー\",\"value\":\"p2\"},{\"label\":\"1｜介入必要\",\"value\":\"p1\"},{\"label\":\"－ 確認できず（採点対象外）\",\"value\":\"na\"}],\"originalNumber\":9,\"reasons\":[\"理解不足\",\"判断に迷った\",\"忘れていた\",\"動きがまだ身についていない\",\"今回は実施なし・該当場面なし\",\"その他\"],\"rubric\":[\"4：安全確認以外に、チラシの準備で歩きを止めなかった\",\"3：1回の助言後は準備による立ち止まりをなくせた\",\"2：2回以上、持ち方や準備について助言が必要だった\",\"1：助言後も準備のたびに止まり、動作の実演が必要だった\"],\"title\":\"安全確認が必要な場面以外は、歩きを止めずに配布できた\"},{\"id\":\"q09\",\"note\":\"折れ・破れ・向きに注意し、丁寧に奥まで投函できたか。\",\"options\":[{\"label\":\"4｜自立\",\"value\":\"p4\"},{\"label\":\"3｜軽微フォロー\",\"value\":\"p3\"},{\"label\":\"2｜継続フォロー\",\"value\":\"p2\"},{\"label\":\"1｜介入必要\",\"value\":\"p1\"},{\"label\":\"－ 確認できず（採点対象外）\",\"value\":\"na\"}],\"originalNumber\":11,\"reasons\":[\"理解不足\",\"判断に迷った\",\"忘れていた\",\"動きがまだ身についていない\",\"今回は実施なし・該当場面なし\",\"その他\"],\"rubric\":[\"4：折れ・破れ・向きに問題なく、自分で投函した\",\"3：1回の指摘後は正しく投函した\",\"2：2回以上、折れ・破れ・向きの修正が必要だった\",\"1：説明後も正しく投函できず、担当者が実演・修正した\"],\"title\":\"チラシを正しく投函できた\"},{\"id\":\"q10\",\"note\":\"ポストの形や投函口の大きさに合わせて、持ち方・入れ方を調整できたか。\",\"options\":[{\"label\":\"4｜自立\",\"value\":\"p4\"},{\"label\":\"3｜軽微フォロー\",\"value\":\"p3\"},{\"label\":\"2｜継続フォロー\",\"value\":\"p2\"},{\"label\":\"1｜介入必要\",\"value\":\"p1\"},{\"label\":\"－ 確認できず（採点対象外）\",\"value\":\"na\"}],\"originalNumber\":13,\"reasons\":[\"理解不足\",\"判断に迷った\",\"忘れていた\",\"動きがまだ身についていない\",\"今回は実施なし・該当場面なし\",\"その他\"],\"rubric\":[\"4：投函口に合わせて自分で持ち方・入れ方を変えた\",\"3：1回の助言後は投函口に合わせて変えられた\",\"2：2回以上、入れ方の助言が必要だった\",\"1：担当者が入れ方をその都度示す必要があった\"],\"title\":\"ポストに合わせて入れ方を変えられた\"},{\"id\":\"q11\",\"note\":\"雨濡れや落下につながらないよう、チラシ全体をポスト内へ収められたか。\",\"options\":[{\"label\":\"4｜自立\",\"value\":\"p4\"},{\"label\":\"3｜軽微フォロー\",\"value\":\"p3\"},{\"label\":\"2｜継続フォロー\",\"value\":\"p2\"},{\"label\":\"1｜介入必要\",\"value\":\"p1\"},{\"label\":\"－ 確認できず（採点対象外）\",\"value\":\"na\"}],\"originalNumber\":14,\"reasons\":[\"理解不足\",\"判断に迷った\",\"忘れていた\",\"動きがまだ身についていない\",\"今回は実施なし・該当場面なし\",\"その他\"],\"rubric\":[\"4：確認した投函すべてでチラシ全体がポスト内に収まった\",\"3：1回の指摘後は、はみ出しがなくなった\",\"2：2回以上、はみ出しの修正が必要だった\",\"1：指摘後もはみ出しが続き、担当者が入れ直した\"],\"title\":\"チラシのはみ出しを防げた\"},{\"id\":\"q13\",\"note\":\"配布中に住民と会った際、自分から明るく挨拶できたか。\",\"options\":[{\"label\":\"4｜自立\",\"value\":\"p4\"},{\"label\":\"3｜軽微フォロー\",\"value\":\"p3\"},{\"label\":\"2｜継続フォロー\",\"value\":\"p2\"},{\"label\":\"1｜介入必要\",\"value\":\"p1\"},{\"label\":\"－ 確認できず（採点対象外）\",\"value\":\"na\"}],\"originalNumber\":15,\"reasons\":[\"理解不足\",\"判断に迷った\",\"忘れていた\",\"動きがまだ身についていない\",\"今回は実施なし・該当場面なし\",\"その他\"],\"rubric\":[\"4：住民と会った場面で自分から挨拶した\",\"3：1回の声掛け後は自分から挨拶した\",\"2：2回以上、挨拶の声掛けが必要だった\",\"1：声掛け後も挨拶せず、担当者が対応した\"],\"title\":\"住民へ挨拶できた\"},{\"id\":\"q19\",\"note\":\"\",\"options\":[{\"label\":\"4｜自立\",\"value\":\"p4\"},{\"label\":\"3｜軽微フォロー\",\"value\":\"p3\"},{\"label\":\"2｜継続フォロー\",\"value\":\"p2\"},{\"label\":\"1｜介入必要\",\"value\":\"p1\"},{\"label\":\"－ 確認できず（採点対象外）\",\"value\":\"na\"}],\"originalNumber\":16,\"reasons\":[\"理解不足\",\"判断に迷った\",\"忘れていた\",\"動きがまだ身についていない\",\"今回は実施なし・該当場面なし\",\"その他\"],\"rubric\":[\"4：特定した課題を、再確認時に声掛けなしで改善した\",\"3：再確認時に1回の助言で改善した\",\"2：再確認時に2回以上の助言で改善した\",\"1：再確認時も改善せず、担当者の直接的な補助が必要だった\"],\"title\":\"その人の配布に大きく影響する課題を見つけ、改善できた\"},{\"id\":\"q21\",\"note\":\"\",\"options\":[{\"label\":\"4｜自立\",\"value\":\"p4\"},{\"label\":\"3｜軽微フォロー\",\"value\":\"p3\"},{\"label\":\"2｜継続フォロー\",\"value\":\"p2\"},{\"label\":\"1｜介入必要\",\"value\":\"p1\"},{\"label\":\"－ 確認できず（採点対象外）\",\"value\":\"na\"}],\"originalNumber\":17,\"reasons\":[\"理解不足\",\"判断に迷った\",\"忘れていた\",\"動きがまだ身についていない\",\"今回は実施なし・該当場面なし\",\"その他\"],\"rubric\":[\"4：教えた動作を、その後の確認場面で声掛けなしで実践した\",\"3：1回の声掛け後は教えた動作を実践した\",\"2：2回以上、同じ内容の声掛けが必要だった\",\"1：声掛け後も実践できず、再実演・直接的な補助が必要だった\"],\"title\":\"教えたことを、声掛けなしで実践できた\"}];\nconst DRAFT_KEY='postechFollowupDraftV2';\nconst fields=['trainee','trainer','date','delivery','issue','taught','share'];\nconst $=id=>document.getElementById(id);\nconst esc=s=>String(s??'').replace(/[&<>\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c]));\nfunction today(){const d=new Date();return [d.getFullYear(),String(d.getMonth()+1).padStart(2,'0'),String(d.getDate()).padStart(2,'0')].join('-');}\nfunction uuid(){if(window.crypto?.randomUUID)return window.crypto.randomUUID();const a=new Uint8Array(16);window.crypto.getRandomValues(a);return Array.from(a,n=>n.toString(16).padStart(2,'0')).join('');}\nfunction blank(){return {submissionId:uuid(),answers:{},date:today()};}\nlet state=blank(),busy=false;\ntry{const saved=JSON.parse(localStorage.getItem(DRAFT_KEY)||'null');if(saved&&typeof saved==='object'&&saved.answers&&/^[a-f0-9-]{32,36}$/i.test(saved.submissionId)){state={...state,...saved};for(const q of QUESTIONS){if(!q.options.some(o=>o.value===state.answers[q.id]?.value))delete state.answers[q.id];}}}catch{}\nfunction stash(){try{localStorage.setItem(DRAFT_KEY,JSON.stringify(state));$('draftStatus').textContent='入力途中の内容は、この端末に保存されています。';$('draftStatus').classList.remove('error');}catch{$('draftStatus').textContent='この端末に入力内容を保存できません。提出が完了するまで画面を閉じないでください。';$('draftStatus').classList.add('error');}}\nfunction needsDetail(q,value){return value&&value!=='p4'&&value!=='done';}\nfunction update(){const count=QUESTIONS.filter(q=>state.answers[q.id]?.value).length;$('progress').textContent=count+' / '+QUESTIONS.length;if(!busy)$('status').textContent=count===QUESTIONS.length?'入力内容を確認して提出してください。':'残り'+(QUESTIONS.length-count)+'項目';}\nfunction render(){for(const id of fields)$(id).value=state[id]||'';$('questions').innerHTML=QUESTIONS.map((q,i)=>{const a=state.answers[q.id]||{};return `<article id=\"question-${q.id}\"><div class=\"question-top\"><span class=\"number\">${String(i+1).padStart(2,'0')}</span><div><div class=\"title\">${esc(q.title)}</div>${q.note?`<p class=\"note\">${esc(q.note)}</p>`:''}</div></div><div class=\"rubric\">${q.rubric.map(r=>`<p>${esc(r)}</p>`).join('')}</div><div class=\"choices\" role=\"group\" aria-label=\"${esc(q.title)}\">${q.options.map(o=>`<button type=\"button\" data-question=\"${q.id}\" data-value=\"${o.value}\" aria-pressed=\"${a.value===o.value}\">${esc(o.label)}</button>`).join('')}</div><div id=\"detail-${q.id}\" class=\"detail\" ${needsDetail(q,a.value)?'':'hidden'}><div class=\"grid\"><div><label for=\"reason-${q.id}\">理由</label><select id=\"reason-${q.id}\" data-reason=\"${q.id}\"><option value=\"\">選択してください</option>${q.reasons.map(r=>`<option ${r===a.reason?'selected':''}>${esc(r)}</option>`).join('')}</select></div><div><label for=\"note-${q.id}\">今回伝えたこと</label><textarea id=\"note-${q.id}\" data-note=\"${q.id}\" maxlength=\"5000\">${esc(a.note||'')}</textarea></div></div></div></article>`;}).join('');update();}\nfields.forEach(id=>$(id).addEventListener('input',()=>{state[id]=$(id).value;stash();}));\n$('questions').addEventListener('click',e=>{const b=e.target.closest('button[data-question]');if(!b||busy)return;const id=b.dataset.question;state.answers[id]={...(state.answers[id]||{}),value:b.dataset.value};document.querySelectorAll('[data-question=\"'+id+'\"]').forEach(el=>el.setAttribute('aria-pressed',String(el===b)));$('detail-'+id).hidden=!needsDetail(null,b.dataset.value);stash();update();});\n$('questions').addEventListener('input',e=>{const id=e.target.dataset.reason||e.target.dataset.note;if(!id)return;state.answers[id]={...(state.answers[id]||{}),[e.target.dataset.reason?'reason':'note']:e.target.value};stash();});\nfunction validate(){for(const q of QUESTIONS){const a=state.answers[q.id];if(!a?.value){$('question-'+q.id).scrollIntoView({behavior:'smooth',block:'center'});return '未回答の項目があります。';}if(needsDetail(q,a.value)&&!a.reason){$('reason-'+q.id).focus();return '理由を選択してください。';}if(needsDetail(q,a.value)&&a.value!=='na'&&!a.note?.trim()){$('note-'+q.id).focus();return '今回伝えたことを入力してください。';}}return '';}\nfunction freeze(v){busy=v;document.querySelectorAll('#reportForm input,#reportForm textarea,#reportForm select,#reportForm button').forEach(e=>e.disabled=v);$('submit').disabled=v;}\n$('reportForm').addEventListener('submit',e=>{e.preventDefault();if(busy)return;const error=validate();if(error){$('status').textContent=error;$('status').dataset.error='true';return;}if(!window.google?.script?.run){$('status').textContent='まだ提出できません。担当者にフォームの接続状況を確認してください。';$('status').dataset.error='true';return;}for(const id of fields)state[id]=$(id).value;stash();freeze(true);$('status').dataset.error='false';$('status').textContent='保存しています。画面を閉じずにお待ちください。';const payload={...state,answers:{...state.answers}};window.google.script.run.withSuccessHandler(result=>{if(!result?.ok){fail(new Error('保存結果を確認できませんでした。'));return;}try{localStorage.removeItem(DRAFT_KEY);}catch{}$('formContent').hidden=true;$('success').hidden=false;$('savedInfo').textContent='配布員：'+state.trainee+' ／ 確認日：'+state.date;$('status').textContent='保存が完了しました。';$('submit').hidden=true;window.scrollTo(0,0);}).withFailureHandler(fail).submitReport(payload);});\nfunction fail(error){freeze(false);$('status').textContent=(error?.message||'保存できませんでした。')+'\\n入力内容は残っています。同じ内容で再送できます。';$('status').dataset.error='true';}\n$('next').addEventListener('click',()=>{state=blank();freeze(false);$('formContent').hidden=false;$('success').hidden=true;$('submit').hidden=false;$('status').dataset.error='false';render();stash();window.scrollTo(0,0);});\nrender();\n</script></body></html>\n";

function doGet() {
  return HtmlService.createHtmlOutput(REPORT_HTML).setTitle('フォローアップ確認フォーム').addMetaTag('viewport','width=device-width,initial-scale=1');
}

/** 最初にエディタから1回実行。既存19件は変更しません。 */
function setup() {
  const lock=LockService.getScriptLock();lock.waitLock(30000);
  try { const sheet=getFollowupSheet_();ensureHeaders_(sheet);return '準備完了。既存回答は変更していません。'; }
  finally {lock.releaseLock();}
}

function getFollowupSheet_() {
  const sheet=SpreadsheetApp.openById(FOLLOWUP_CONFIG.spreadsheetId).getSheetByName(FOLLOWUP_CONFIG.sheetName);
  if(!sheet)throw new Error('保存先のフォローアップタブが見つかりません。');
  return sheet;
}

function expectedHeaders_() {
  const h=['確認日','研修担当者','配布員名','配布区分','提出日時','評価点（元画面）','今回の課題','今回伝えたこと・指導後の変化','社員への共有','取得元','取得日','回答ID','フォーム版'];
  FOLLOWUP_QUESTIONS.forEach(q=>h.push(q.title+'【評価】',q.title+'【理由】',q.title+'【指導内容】'));
  return h;
}

function ensureHeaders_(sheet) {
  const headers=sheet.getRange(1,1,1,Math.max(1,sheet.getLastColumn())).getValues()[0].map(String);
  if(headers.filter(Boolean).length===0)throw new Error('既存の列見出しがありません。保存先を確認してください。');
  const populated=headers.filter(Boolean);if(new Set(populated).size!==populated.length)throw new Error('保存先に重複する列名があります。担当者へ連絡してください。');
  const missing=expectedHeaders_().filter(h=>!headers.includes(h));
  if(missing.length){const start=sheet.getLastColumn()+1,need=start+missing.length-1;if(need>sheet.getMaxColumns())sheet.insertColumnsAfter(sheet.getMaxColumns(),need-sheet.getMaxColumns());sheet.getRange(1,start,1,missing.length).setValues([missing]);headers.splice(start-1,missing.length,...missing);}
  return headers;
}

function cleanText_(value,max) {if(typeof value!=='string'||value.length>max)throw new Error('入力内容の長さを確認してください。');return value.trim();}
function safeCell_(value) {return typeof value==='string'&&/^\s*[=+@-]/.test(value)?"'"+value:value;}
function validateReport_(p) {
  if(!p||typeof p!=='object')throw new Error('入力内容がありません。');
  if(typeof p.submissionId!=='string'||!/^[a-f0-9-]{32,36}$/i.test(p.submissionId))throw new Error('回答IDが正しくありません。画面を開き直してください。');
  const data={submissionId:p.submissionId,trainee:cleanText_(p.trainee,100),trainer:cleanText_(p.trainer,100),date:cleanText_(p.date,10),delivery:p.delivery,issue:cleanText_(p.issue||'',5000),taught:cleanText_(p.taught||'',5000),share:cleanText_(p.share||'',5000),answers:{}};
  if(!data.trainee||!data.trainer)throw new Error('配布員名・研修員名を入力してください。');
  if(!/^\d{4}-\d{2}-\d{2}$/.test(data.date))throw new Error('確認日が正しくありません。');
  const parsed=new Date(data.date+'T00:00:00Z');if(isNaN(parsed.getTime())||Utilities.formatDate(parsed,'UTC','yyyy-MM-dd')!==data.date)throw new Error('確認日が正しくありません。');
  if(!['単配','併配'].includes(data.delivery))throw new Error('今回の配布を選択してください。');
  if(!p.answers||typeof p.answers!=='object')throw new Error('評価項目を回答してください。');
  FOLLOWUP_QUESTIONS.forEach(q=>{const a=p.answers[q.id];if(!a||!q.options.some(o=>o.value===a.value))throw new Error('未回答の項目があります。');const detail=a.value!=='p4'&&a.value!=='done';const reason=detail?cleanText_(a.reason||'',100):'',note=detail?cleanText_(a.note||'',5000):'';if(detail&&!q.reasons.includes(reason))throw new Error('理由を選択してください。');if(detail&&a.value!=='na'&&!note)throw new Error('今回伝えたことを入力してください。');data.answers[q.id]={value:a.value,reason,note};});
  return data;
}

function submitReport(payload) {
  const p=validateReport_(payload);const lock=LockService.getScriptLock();lock.waitLock(30000);
  try {
    const sheet=getFollowupSheet_(),headers=ensureHeaders_(sheet),idCol=headers.indexOf('回答ID')+1,lastRow=sheet.getLastRow();
    if(lastRow>1){const found=sheet.getRange(2,idCol,lastRow-1,1).createTextFinder(p.submissionId).matchEntireCell(true).useRegularExpression(false).findNext();if(found)return {ok:true,duplicate:true};}
    const now=new Date(),tz='Asia/Tokyo',score=FOLLOWUP_QUESTIONS.map(q=>p.answers[q.id].value).filter(v=>/^p[1-4]$/.test(v)),points=score.reduce((sum,v)=>sum+Number(v.slice(1)),0);
    const fields={'確認日':p.date,'研修担当者':p.trainer,'配布員名':p.trainee,'配布区分':p.delivery,'提出日時':Utilities.formatDate(now,tz,'yyyy/MM/dd HH:mm:ss'),'評価点（元画面）':'評価点 '+points+' / '+(score.length*4)+'点（採点済み'+score.length+'項目）','今回の課題':p.issue,'今回伝えたこと・指導後の変化':p.taught,'社員への共有':p.share,'取得元':'フォローアップ14項目版','取得日':Utilities.formatDate(now,tz,'yyyy-MM-dd'),'回答ID':p.submissionId,'フォーム版':FOLLOWUP_CONFIG.version};
    FOLLOWUP_QUESTIONS.forEach(q=>{const a=p.answers[q.id];fields[q.title+'【評価】']=q.options.find(o=>o.value===a.value).label;fields[q.title+'【理由】']=a.reason;fields[q.title+'【指導内容】']=a.note;});
    const row=headers.map(h=>['確認日','取得日'].includes(h)?new Date(fields[h]+'T00:00:00+09:00'):safeCell_(Object.prototype.hasOwnProperty.call(fields,h)?fields[h]:'')),target=lastRow+1;
    if(target>sheet.getMaxRows())sheet.insertRowsAfter(sheet.getMaxRows(),100);
    sheet.getRange(target,1,1,row.length).setValues([row]);
    for(const h of ['確認日','取得日'])sheet.getRange(target,headers.indexOf(h)+1).setNumberFormat('yyyy-mm-dd');
    SpreadsheetApp.flush();return {ok:true,duplicate:false};
  } finally {lock.releaseLock();}
}
